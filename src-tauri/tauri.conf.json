{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knot",
  "version": "0.2.0",
  "identifier": "com.thinkrail.knot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Knot",
        "width": 1280,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Whenyd",
    "copyright": "© 2026 Whenyd",
    "shortDescription": "A local-first desktop task manager for developer work",
    "longDescription": "Knot is a local-first desktop task manager for developers, with project, module and submodule grouping plus one level of subtasks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "zh-CN"]
      }
    }
  }
}
